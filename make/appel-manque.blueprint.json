      "mapper": {
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say language=\"fr-FR\">Bonjour, vous etes bien chez {{replace(replace(replace(3.data.entreprise; \"&\"; \"&amp;\"); \"<\"; \"&lt;\"); \">\"; \"&gt;\")}}. Je ne peux pas repondre dans l'immediat. Je vous envoie tout de suite un message : decrivez-y votre besoin, je vous rappelle. A tres vite.</Say>\n  <Hangup/>\n</Response>",
        "status": "200",
        "headers": [{ "key": "Content-Type", "value": "text/xml; charset=utf-8" }]
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "expect": [
          { "name": "status", "type": "text", "label": "Status", "required": true },
          { "name": "body", "type": "text", "label": "Body" },
          {
            "name": "headers",
            "type": "array",
